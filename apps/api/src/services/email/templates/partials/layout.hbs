<!DOCTYPE html>
<html lang="en" xmlns="http://www.w3.org/1999/xhtml" xmlns:o="urn:schemas-microsoft-com:office:office">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width,initial-scale=1" />
  <meta http-equiv="X-UA-Compatible" content="IE=edge" />
  <meta name="x-apple-disable-message-reformatting" />
  <meta name="color-scheme" content="light dark" />
  <meta name="supported-color-schemes" content="light dark" />
  <title>{{subject}}</title>
  <!--[if mso]>
  <style type="text/css">
    table, td, div, h1, p { font-family: 'Segoe UI', Arial, sans-serif !important; }
  </style>
  <![endif]-->
  <style>
    /* Reset */
    body, table, td, p, a { -webkit-text-size-adjust: 100%; -ms-text-size-adjust: 100%; }
    table, td { mso-table-lspace: 0pt; mso-table-rspace: 0pt; }
    img { -ms-interpolation-mode: bicubic; border: 0; outline: none; text-decoration: none; }
    body { margin: 0 !important; padding: 0 !important; width: 100% !important; }
    a { text-decoration: none; }

    /* Base */
    body {
      background-color: #f5f5f7;
      font-family: -apple-system, BlinkMacSystemFont, 'Inter', 'SF Pro Text', 'Segoe UI', Roboto, Helvetica, Arial, sans-serif;
      color: #1d1d1f;
      line-height: 1.55;
    }
    .wrapper { width: 100%; background-color: #f5f5f7; padding: 48px 16px; }
    .card {
      max-width: 560px;
      margin: 0 auto;
      background-color: #ffffff;
      border-radius: 16px;
      box-shadow: 0 1px 2px rgba(0,0,0,0.04), 0 8px 24px rgba(0,0,0,0.06);
      overflow: hidden;
    }
    .header { padding: 40px 48px 0; }
    .brand {
      font-size: 14px;
      font-weight: 600;
      letter-spacing: -0.01em;
      color: {{brandColor}};
    }
    .brand-dot {
      display: inline-block;
      width: 8px;
      height: 8px;
      border-radius: 50%;
      background-color: {{accentColor}};
      vertical-align: middle;
      margin-right: 8px;
    }
    .body { padding: 32px 48px 8px; }
    h1 {
      font-size: 26px;
      line-height: 1.25;
      font-weight: 600;
      letter-spacing: -0.02em;
      color: #0a0a0a;
      margin: 0 0 16px;
    }
    p { font-size: 16px; color: #424245; margin: 0 0 16px; }
    .muted { color: #6e6e73; font-size: 14px; }

    .cta-wrap { padding: 16px 48px 8px; }
    .cta {
      display: inline-block;
      background-color: #0a0a0a;
      color: #ffffff !important;
      font-size: 15px;
      font-weight: 600;
      letter-spacing: -0.005em;
      padding: 14px 28px;
      border-radius: 10px;
      mso-padding-alt: 0;
    }
    .cta-secondary {
      display: inline-block;
      color: #0a0a0a !important;
      font-size: 14px;
      font-weight: 500;
      padding: 10px 0;
    }

    .meta {
      margin: 24px 48px;
      padding: 16px 20px;
      background-color: #f5f5f7;
      border-radius: 12px;
      font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
      font-size: 13px;
      color: #1d1d1f;
    }
    .meta-row { display: block; padding: 4px 0; }
    .meta-key { color: #6e6e73; }

    .link-fallback {
      font-family: ui-monospace, SFMono-Regular, 'SF Mono', Menlo, Consolas, monospace;
      font-size: 12px;
      color: #6e6e73;
      word-break: break-all;
      background-color: #f5f5f7;
      padding: 12px 16px;
      border-radius: 8px;
      margin: 0 48px 24px;
    }

    .divider { height: 1px; background-color: #e8e8ed; margin: 32px 48px 0; }

    .footer { padding: 24px 48px 40px; }
    .footer p { font-size: 12px; color: #86868b; margin: 4px 0; }
    .footer a { color: #6e6e73; }

    /* Dark mode */
    @media (prefers-color-scheme: dark) {
      body, .wrapper { background-color: #000 !important; }
      .card { background-color: #111 !important; box-shadow: none !important; }
      h1 { color: #f5f5f7 !important; }
      p { color: #c7c7cc !important; }
      .muted, .footer p { color: #86868b !important; }
      .meta, .link-fallback { background-color: #1c1c1e !important; color: #f5f5f7 !important; }
      .meta-key { color: #86868b !important; }
      .cta { background-color: #ffffff !important; color: #0a0a0a !important; }
      .cta-secondary { color: #ffffff !important; }
      .divider { background-color: #2c2c2e !important; }
    }

    /* Mobile */
    @media only screen and (max-width: 600px) {
      .wrapper { padding: 16px 8px !important; }
      .card { border-radius: 12px !important; }
      .header { padding: 28px 24px 0 !important; }
      .body, .cta-wrap, .footer { padding-left: 24px !important; padding-right: 24px !important; }
      .meta, .link-fallback { margin-left: 24px !important; margin-right: 24px !important; }
      .divider { margin-left: 24px !important; margin-right: 24px !important; }
      h1 { font-size: 22px !important; }
      p { font-size: 15px !important; }
      .cta { display: block !important; text-align: center !important; }
    }
  </style>
</head>
<body>
  <div class="wrapper">
    <table role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0">
      <tr>
        <td align="center">
          <table class="card" role="presentation" width="100%" cellpadding="0" cellspacing="0" border="0" style="max-width:560px;">
            <tr>
              <td class="header">
                <span class="brand-dot"></span><span class="brand">{{appName}}</span>
              </td>
            </tr>
            <tr>
              <td>
                {{{body}}}
              </td>
            </tr>
            <tr>
              <td>
                <div class="divider"></div>
                <div class="footer">
                  <p>Need help? Reach us at <a href="mailto:{{supportEmail}}">{{supportEmail}}</a>.</p>
                  <p>© {{year}} {{appName}}. All rights reserved.</p>
                  <p>This is a transactional message. If you didn't expect it, you can safely ignore this email.</p>
                </div>
              </td>
            </tr>
          </table>
        </td>
      </tr>
    </table>
  </div>
</body>
</html>
