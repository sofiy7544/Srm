<div class="body">
  <h1>{{inviterName}} invited you to {{appName}}</h1>
  <p>You've been invited to join the team as <strong>{{role}}</strong>. Accept the invitation to create your account and get started.</p>
</div>
<div class="meta">
  <span class="meta-row"><span class="meta-key">Invited by:</span> {{inviterName}} &lt;{{inviterEmail}}&gt;</span>
  <span class="meta-row"><span class="meta-key">For:</span> {{inviteeEmail}}</span>
  <span class="meta-row"><span class="meta-key">Role:</span> {{role}}</span>
</div>
<div class="cta-wrap">
  <a href="{{acceptUrl}}" class="cta">Accept invitation</a>
</div>
<div class="body" style="padding-top:24px;">
  <p class="muted">This invitation expires in {{expiresInDays}} days. If you weren't expecting it, you can safely ignore this email — the invitation can't be used by anyone else.</p>
</div>
<div class="link-fallback">{{acceptUrl}}</div>
