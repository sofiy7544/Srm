<div class="body">
  <h1>Verify your email</h1>
  <p>Hi {{fullName}}, one quick step to confirm this is really you. Verify your email to unlock everything in {{appName}}.</p>
</div>
<div class="cta-wrap">
  <a href="{{verifyUrl}}" class="cta">Verify email</a>
</div>
<div class="body" style="padding-top:24px;">
  <p class="muted">This link expires in {{expiresInHours}} hours. If you didn't create an account, you can ignore this email.</p>
</div>
<div class="link-fallback">{{verifyUrl}}</div>
