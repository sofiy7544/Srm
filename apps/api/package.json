{
  "name": "@crm/api",
  "version": "0.1.0",
  "private": true,
  "description": "Real Estate CRM API (NestJS)",
  "scripts": {
    "dev": "tsc -p tsconfig.json --watch --noEmit false & sleep 3 && node --watch dist/main.js & wait",
    "build": "tsc -p tsconfig.json --noEmit false && pnpm run copy:templates",
    "copy:templates": "node -e \"const fs=require('fs'),p=require('path');const s='src/services/email/templates',d='dist/services/email/templates';fs.mkdirSync(p.join(d,'partials'),{recursive:true});for(const f of fs.readdirSync(s)){const fp=p.join(s,f);if(fs.statSync(fp).isFile())fs.copyFileSync(fp,p.join(d,f));}for(const f of fs.readdirSync(p.join(s,'partials')))fs.copyFileSync(p.join(s,'partials',f),p.join(d,'partials',f));console.log('Copied email templates to dist')\"",
    "start": "node dist/main.js",
    "lint": "eslint \"src/**/*.ts\" --max-warnings 0",
    "typecheck": "tsc --noEmit",
    "test": "jest --passWithNoTests",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "prisma migrate dev",
    "prisma:deploy": "prisma migrate deploy",
    "prisma:seed": "tsx prisma/seed.ts",
    "prisma:reset-to-production": "tsx prisma/reset-to-production.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.665.0",
    "@aws-sdk/s3-request-presigner": "^3.665.0",
    "@crm/shared": "workspace:*",
    "@nestjs/common": "^10.4.5",
    "@nestjs/config": "^3.2.3",
    "@nestjs/core": "^10.4.5",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.5",
    "@nestjs/schedule": "^4.1.1",
    "@nestjs/throttler": "^6.2.1",
    "@prisma/client": "^5.21.1",
    "bullmq": "^5.21.2",
    "ioredis": "^5.4.1",
    "argon2": "^0.41.1",
    "cookie-parser": "^1.4.7",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "handlebars": "^4.7.8",
    "nestjs-zod": "^4.3.1",
    "nodemailer": "^6.9.16",
    "resend": "^4.0.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@nestjs/cli": "^10.4.5",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.5",
    "@types/express": "^5.0.0",
    "@types/jest": "^29.5.13",
    "@types/cookie-parser": "^1.4.7",
    "@types/multer": "^1.4.12",
    "@types/node": "^22.7.5",
    "@types/nodemailer": "^6.4.16",
    "@types/passport-jwt": "^4.0.1",
    "@typescript-eslint/eslint-plugin": "^8.8.1",
    "@typescript-eslint/parser": "^8.8.1",
    "eslint": "^9.12.0",
    "jest": "^29.7.0",
    "prisma": "^5.21.1",
    "ts-jest": "^29.2.5",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "tsconfig-paths": "^4.2.0",
    "tsx": "^4.19.1",
    "typescript": "^5.6.3"
  }
}
