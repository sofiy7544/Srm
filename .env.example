# ──────────────────────────────────────────────
# stanley-fitness-audience-crm — environment template
# Copy to .env and fill in real values. NEVER commit .env.
# ──────────────────────────────────────────────

# --- App ---
APP_NAME=stanley-fitness-audience-crm
APP_ENV=development
DEBUG=true
SECRET_KEY=change-me-to-a-long-random-string-min-32-chars
# Comma-separated origins for CORS, or * for all (dev only)
CORS_ORIGINS=*

# --- Admin auth (admin panel login) ---
ADMIN_USERNAME=admin
# Generate a hash with: python -m app.core.security hash "your-password"
# If ADMIN_PASSWORD_HASH is empty, ADMIN_PASSWORD (plain) is used as a dev fallback.
ADMIN_PASSWORD=admin12345
ADMIN_PASSWORD_HASH=

# --- Database ---
# Local quick start without Postgres: sqlite+pysqlite:///./dev.sqlite3
DATABASE_URL=postgresql+psycopg2://crm:crm@localhost:5432/crm

# --- Redis / Celery ---
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/2

# --- Meta / Facebook (official APIs only) ---
META_APP_ID=
META_APP_SECRET=
META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=act_xxxxxxxxxx
META_PAGE_ID=
# Instagram Business account id linked to the Page (for IG publishing/messaging)
META_IG_USER_ID=
META_PIXEL_ID=
META_API_VERSION=v21.0
# Token you choose; must match the value entered in Meta webhook setup
VERIFY_TOKEN=choose-a-random-verify-token

# --- Telegram ---
TELEGRAM_BOT_TOKEN=
# Default chat/manager id to notify on new leads (optional)
TELEGRAM_MANAGER_CHAT_ID=

# --- Rate limiting ---
RATE_LIMIT_DEFAULT=120/minute
