# ── HTTP control server ────────────────────────────────────────────────
PORT=3001

# ── Browser (Playwright) ───────────────────────────────────────────────
# Where the persistent Chrome profile lives (keeps you logged into
# Telegram Web and the SMS panel between runs). Relative to project root.
USER_DATA_DIR=.chrome-profile
# Show the browser window (recommended so you can scan the QR / watch it work).
HEADLESS=false
# Slow down actions by N ms — handy while tuning selectors. 0 in production.
SLOW_MO=0

# ── Telegram Web (no bot — reads the group like a human) ───────────────
# The group to watch. Match by its visible title in the chat list.
TG_GROUP_TITLE=My Internal Group
# How often to poll the open chat for new messages, in ms.
TG_POLL_INTERVAL_MS=2000

# ── Trigger parsing ────────────────────────────────────────────────────
# A message is only processed if it contains this keyword (case-insensitive).
TRIGGER_KEYWORD=SMS
# Regex with named groups <phone>, <text>, <from> extracted from the message.
# Default matches, e.g.:
#   SMS
#   Номер: +79991234567
#   От: Иван
#   Текст: Ваш заказ готов
# Tune this to match exactly how your team writes messages.
TRIGGER_REGEX=Номер:\s*(?<phone>\+?\d[\d\s\-()]{7,})[\s\S]*?От:\s*(?<from>.+?)\s*[\r\n][\s\S]*?Текст:\s*(?<text>[\s\S]+)

# ── SMS web panel (browser-automated) ──────────────────────────────────
# The URL of the send-SMS page on your panel.
SMS_PANEL_URL=https://sms.example.com/send
# CSS selectors for the form fields on that page. FILL THESE IN for your panel.
SMS_SEL_PHONE=input[name="phone"]
SMS_SEL_FROM=input[name="sender"]
SMS_SEL_TEXT=textarea[name="message"]
SMS_SEL_SUBMIT=button[type="submit"]
# Optional selector that appears ONLY on success (e.g. a toast). Leave empty to skip.
SMS_SEL_SUCCESS=.toast-success

# ── Safety ─────────────────────────────────────────────────────────────
# If true, the whole pipeline runs but the final "submit" click is skipped
# and logged instead. Use this while testing so no real SMS goes out.
DRY_RUN=true
