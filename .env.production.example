# ═════════════════════════════════════════════════════════════════════
#  Real Estate CRM — PRODUCTION environment template
#  Copy to `.env` on the production server and fill every value.
#  Generate secrets with: openssl rand -base64 48
# ═════════════════════════════════════════════════════════════════════

# ── 1. General ───────────────────────────────────────────────────────
NODE_ENV=production
TZ=Europe/Kyiv             # Server time zone — affects scheduled crons

# ── 2. Domain & URLs ─────────────────────────────────────────────────
# Public-facing URLs. Used in email links, OAuth callbacks, CORS, etc.
APP_URL=https://crm.yourdomain.com
NEXT_PUBLIC_API_URL=https://crm.yourdomain.com    # API is reverse-proxied at /api
WEB_ORIGIN=https://crm.yourdomain.com             # CORS allowlist (comma-sep multi)

# ── 3. PostgreSQL ────────────────────────────────────────────────────
# Internal Docker network — `postgres` is the service name in compose.
POSTGRES_USER=crm
POSTGRES_PASSWORD=CHANGE_ME_USE_STRONG_PASSWORD_min_24_chars
POSTGRES_DB=crm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:CHANGE_ME_USE_STRONG_PASSWORD_min_24_chars@postgres:5432/crm?schema=public

# ── 4. Redis (BullMQ queues, sessions) ───────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://redis:6379

# ── 5. File Storage ──────────────────────────────────────────────────
# Option A — self-hosted MinIO (default, included in compose)
MINIO_ROOT_USER=crm-minio-admin
MINIO_ROOT_PASSWORD=CHANGE_ME_MINIO_STRONG_PASSWORD
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_BUCKET=crm-public
MINIO_PRIVATE_BUCKET=crm-private
MINIO_ENDPOINT=http://minio:9000

# Option B — AWS S3 (override MinIO; uncomment to use)
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# AWS_S3_PUBLIC_BUCKET=crm-public
# AWS_S3_PRIVATE_BUCKET=crm-private

# ── 6. API (NestJS) ──────────────────────────────────────────────────
API_PORT=3001
API_URL=http://api:3001        # Internal Docker URL

# JWT secrets — MUST be >= 32 chars, MUST be different for access/refresh
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET=REPLACE_WITH_openssl_rand_base64_48_OUTPUT
JWT_REFRESH_SECRET=REPLACE_WITH_DIFFERENT_openssl_rand_base64_48_OUTPUT
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# ── 7. Email (Resend) ────────────────────────────────────────────────
# Get key: https://resend.com/api-keys
RESEND_API_KEY=re_replace_with_real_key
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Your Agency Name
EMAIL_REPLY_TO=support@yourdomain.com
EMAIL_SUPPORT=support@yourdomain.com
APP_NAME=Your Agency CRM
EMAIL_SYNC=false                # false = via BullMQ queue (recommended)
EMAIL_BRAND_COLOR=#1d4ed8
EMAIL_ACCENT_COLOR=#7c3aed

# ── 8. Telegram Bot (omnichannel inbox) ──────────────────────────────
# 1. Talk to @BotFather → /newbot → copy token
# 2. Generate webhook secret:  openssl rand -hex 20
# 3. After deploy: POST https://crm.yourdomain.com/api/telegram/setup
#    with body { webhookUrl: "https://crm.yourdomain.com/api/telegram/webhook" }
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# ── 9. Locale & i18n ─────────────────────────────────────────────────
NEXT_PUBLIC_DEFAULT_LOCALE=uk    # uk | ru | en | fr | it

# ── 10. Monitoring (optional) ────────────────────────────────────────
# SENTRY_DSN=                    # Error tracking
# LOG_LEVEL=info                 # error | warn | info | debug

# ── 11. Security ─────────────────────────────────────────────────────
# Bcrypt cost (10-12 for prod; 8 only on tiny VPS)
ARGON2_TIME_COST=3
ARGON2_MEMORY_COST=65536         # 64 MB
# Trust the nginx reverse-proxy headers (X-Forwarded-For)
TRUST_PROXY=true
