<div class="body">
  <h1>Reset your password</h1>
  <p>Hi {{fullName}}, we received a request to reset the password for your {{appName}} account. Click below to choose a new one.</p>
</div>
<div class="cta-wrap">
  <a href="{{resetUrl}}" class="cta">Reset password</a>
</div>
<div class="body" style="padding-top:24px;">
  <p class="muted">This link expires in {{expiresInMinutes}} minutes and can only be used once. If you didn't request this, your password is still safe — you can ignore this message.</p>
</div>
{{#if requestIp}}
<div class="meta">
  <span class="meta-row"><span class="meta-key">Request IP:</span> {{requestIp}}</span>
</div>
{{/if}}
<div class="link-fallback">{{resetUrl}}</div>
