# ═══════════════════════════════════════════════════════════════════
#  Real Estate CRM — Environment Configuration
#  Copy this file to .env and fill in the values.
#  For production, use strong random secrets (openssl rand -base64 48).
# ═══════════════════════════════════════════════════════════════════

# ── General ──────────────────────────────────────────────────────────
NODE_ENV=development            # development | production
TZ=Europe/Kyiv

# ── Database (PostgreSQL) ─────────────────────────────────────────────
POSTGRES_USER=crm
POSTGRES_PASSWORD=crm_dev_password     # CHANGE in production!
POSTGRES_DB=crm
POSTGRES_PORT=5432
DATABASE_URL=postgresql://crm:crm_dev_password@localhost:5432/crm?schema=public

# ── Redis (BullMQ job queue) ──────────────────────────────────────────
REDIS_PORT=6379
REDIS_URL=redis://localhost:6379

# ── File Storage (MinIO / S3-compatible) ──────────────────────────────
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=minioadmin_dev     # CHANGE in production!
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_PUBLIC_BUCKET=crm-public         # bucket for property images, public read
MINIO_PRIVATE_BUCKET=crm-private       # bucket for documents, signed URLs only
MINIO_ENDPOINT=http://localhost:9000
# For real S3 set these instead:
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=eu-central-1
# AWS_S3_PUBLIC_BUCKET=crm-public
# AWS_S3_PRIVATE_BUCKET=crm-private

# ── API (NestJS) ──────────────────────────────────────────────────────
API_PORT=3001
API_URL=http://localhost:3001

# JWT — generate with: openssl rand -base64 48
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=30d

# CORS — comma-separated allowed origins in production
WEB_ORIGIN=http://localhost:3000

# ── Web (Next.js) ─────────────────────────────────────────────────────
WEB_PORT=3000
NEXT_PUBLIC_API_URL=http://localhost:3001
NEXT_PUBLIC_DEFAULT_LOCALE=uk

# ── Email (Resend) ────────────────────────────────────────────────────
# Get key at https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxx
EMAIL_FROM=noreply@yourdomain.com
EMAIL_FROM_NAME=Real Estate CRM
EMAIL_REPLY_TO=support@yourdomain.com
# Public URL for email links (verify, reset, invite)
APP_URL=http://localhost:3000
APP_NAME=Real Estate CRM
EMAIL_SUPPORT=support@yourdomain.com
# true = send synchronously (dev only), false = via BullMQ queue
EMAIL_SYNC=false
EMAIL_BRAND_COLOR=#1d4ed8
EMAIL_ACCENT_COLOR=#7c3aed

# ── Channels (Phase 2 — omnichannel) ──────────────────────────────────
# Telegram Bot Integration
# 1. Create bot via @BotFather → copy token here
# 2. Set TELEGRAM_WEBHOOK_SECRET to any random string (openssl rand -hex 20)
# 3. After deploy, call: PO